{
  "name": "scrabblebot-bot-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "npm install --prefix ../spacetimedb && spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test src/strategy.test.ts",
    "build": "tsc",
    "sim": "tsx src/sim/run.ts",
    "observe": "tsx src/observe.ts",
    "local:publish": "spacetime publish --server local --module-path ../spacetimedb scrabblebot -y",
    "local:setup": "tsx src/tools/local-setup.ts",
    "local:bot": "tsx src/index.ts --local"
  },
  "dependencies": {
    "spacetimedb": "^2.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
